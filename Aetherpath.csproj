<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>Aetherpath</AssemblyName>
    <RootNamespace>Aetherpath</RootNamespace>

    <Author>kos</Author>
    <Authors>kos</Authors>
    <Name>Aetherpath</Name>
    <Punchline>Prices every way to get where you're going - and tells you where your free and favored slots earn the most gil.</Punchline>
    <Description>Reads the game's own live teleport prices, then ranks every travel option to your destination: direct teleport, free destination, favored slots, Return, aetheryte tickets, estate teleports and walk-in legs. Includes a slot optimizer that shows what your free transfer and three favored destinations would be worth if you moved them. Recommends only - it never executes a teleport or changes your settings.</Description>
    <PackageTags>teleport;travel;gil;route;aetheryte;economy</PackageTags>
    <RepoUrl>https://github.com/kos/Aetherpath</RepoUrl>
  </PropertyGroup>

  <!-- tools/ holds standalone verification harnesses; they must not be compiled into the plugin. -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

</Project>